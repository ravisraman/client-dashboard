{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "client-dashboard",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "client-dashboard",
      "database_id": "6b3ac554-09c2-43cc-b471-b92c4ce96b9b",
      "migrations_dir": "drizzle"
    }
  ],
  // Non-secret settings. Secrets (API keys) are set with `npx wrangler secret put NAME`.
  "vars": {
    "BETTER_AUTH_URL": "https://client-dashboard.rraman.workers.dev",
    "BRAND_NAME": "Ravi Raman",
    "FOOTER_NAME": "Raman Coaching",
    "ADMIN_TIME_ZONE": "America/Chicago",
    "CHANGE_CUTOFF_HOURS": "24",
    "BOOKING_URL": "https://cal.com/raviraman",
    "EMAIL_FROM": "Ravi Raman <portal@raviraman.com>"
  }
}
