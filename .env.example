# Copy to .env.local for local development (`npm run dev`).
# In production these are set on the Worker: plain settings in wrangler.jsonc "vars",
# secrets with `npx wrangler secret put <NAME>`.

# --- Secrets ---
# Random 32+ character string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Cal.com → Settings → Developer → API keys
CALCOM_API_KEY=cal_live_xxx
# Stripe → Developers → API keys. A restricted key needs read access to
# Customers, Subscriptions, Invoices, Products/Prices and write access to Customer portal.
STRIPE_SECRET_KEY=sk_live_xxx
# Resend API key for sign-in emails. If unset in development, links are printed to the terminal.
RESEND_API_KEY=
# Sender address on a domain verified in Resend
EMAIL_FROM="Ravi Raman <portal@ramancoaching.com>"

# --- Settings ---
BETTER_AUTH_URL=http://localhost:3000
BRAND_NAME=Ravi Raman
FOOTER_NAME=Raman Coaching
BOOKING_URL=https://cal.com/raviraman
ADMIN_TIME_ZONE=America/Chicago
# Clients can't cancel/reschedule online within this many hours of a session (0 = no limit)
CHANGE_CUTOFF_HOURS=24
# Only needed for self-hosted Cal.com
# CALCOM_API_URL=https://api.cal.com
